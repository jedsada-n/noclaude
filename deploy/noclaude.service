[Unit]
Description=noclaude - Claude OAuth proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jedsada
Group=jedsada
WorkingDirectory=/home/jedsada/noclaude
ExecStart=/home/jedsada/.nvm/versions/node/v24.21.0/bin/node /home/jedsada/noclaude/node_modules/tsx/dist/cli.mjs src/index.ts
Restart=on-failure
RestartSec=5

# .env sets PORT=80, a privileged port — grant just enough capability
# to bind it without running the service as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
